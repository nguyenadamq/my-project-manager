# `pnpm bootstrap` writes a .env from this file with a freshly generated token filled in here.
PM_AUTH_TOKEN=replace-with-a-long-random-token
PM_PORT=4174
PM_HOST=127.0.0.1
PM_DATABASE_PATH=./data/pm.db
# Every folder Project Manager may register a repository from, separated by the platform path
# delimiter (`;` on Windows, `:` elsewhere). Nothing outside these paths can be registered or
# even listed in the folder picker. On Windows, escape each backslash as a double backslash:
#   Windows: PM_ALLOWED_ROOTS=C:\\code
#   macOS/Linux: PM_ALLOWED_ROOTS=/Users/you/code
PM_ALLOWED_ROOTS=/path/to/your/repositories
PM_GLOBAL_CONCURRENCY=1
PM_SYNC_DEBOUNCE_MS=30000
PM_CHATGPT_WEEKLY_LIMIT=1000
PM_CHATGPT_RESET_DAY=1
PM_CLAUDE_FIVE_HOUR_LIMIT=100000
PM_CLI_TIMEOUT_MS=1200000
ANTHROPIC_API_KEY=
# Only set this if Claude Code's own local session logs aren't at the default
# ~/.claude/projects (e.g. a non-default CLAUDE_CONFIG_DIR) -- used for the local-transcript
# usage estimate that fills in when live tracking isn't connected.
PM_CLAUDE_PROJECTS_PATH=

# Only set these if `claude`/`codex` aren't already on PATH for the account running the
# server, or a specific install needs to be pinned.
PM_CLAUDE_CLI_PATH=
PM_CODEX_CLI_PATH=

# Live usage tracking (see README: "Live usage tracking"). Reads the real percentages from
# claude.ai and chatgpt.com's own usage pages over Chrome's remote-debugging protocol, in a
# dedicated profile you sign into once via `pnpm --filter @pm/server usage:chrome` -- see
# apps/server/scripts/launch-chrome-debug.mjs.
PM_USAGE_SCRAPE_ENABLED=true
PM_USAGE_SCRAPE_INTERVAL_MS=600000
PM_CHROME_CDP_URL=http://127.0.0.1:9222
# Where launch-chrome-debug.mjs keeps the dedicated profile (default: apps/server/data/usage-profile).
PM_USAGE_PROFILE_PATH=
# Used by launch-chrome-debug.mjs to find Chrome; only set this if Chrome isn't at a
# default install location for your platform.
PM_CHROME_EXECUTABLE_PATH=
